/* ============================================================
   VICE Launcher — Theme A · Pixel Workshop
   Deep indigo · black cards · pixel grain · monospace accents
   ============================================================ */

/* ---------- Color tokens (reference, not used by Qt) ----------
   bg          #0E0A2E
   bgRaised    #15103D
   card        #06030F
   cardBorder  #2A1F6B
   accent      #4F3FD6
   accentSoft  #27188E
   text        #F2F0FF
   textMuted   #9A95C8
   textDim     #5B568A
   success     #4ADE80
   warn        #F5C451
   danger      #F26464
-------------------------------------------------------------- */

/* ---------- Global ---------- */
* {
    outline: none;
}

QWidget {
    background-color: #0E0A2E;
    color: #F2F0FF;
    font-family: "Geist", "Inter", "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #0E0A2E;
}

/* ---------- Sidebar ---------- */
#Sidebar {
    background-color: #15103D;
    border-right: 1px solid #2A1F6B;
    min-width: 220px;
    max-width: 220px;
}

#SidebarBrand {
    font-size: 13px;
    font-weight: 700;
    color: #F2F0FF;
    padding: 18px 18px 4px 18px;
}

#SidebarVersion {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 10px;
    color: #5B568A;
    padding: 0 18px 14px 18px;
}

#SidebarCategoryLabel {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 10px;
    color: #5B568A;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    padding: 8px 18px 6px 18px;
    background: transparent;
}

#SidebarItem {
    background: transparent;
    color: #9A95C8;
    padding: 8px 10px;
    margin: 1px 10px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    border: none;
}

#SidebarItem:hover {
    background-color: #1C154D;
    color: #F2F0FF;
}

#SidebarItemActive {
    background-color: rgba(79, 63, 214, 0.35);
    color: #F2F0FF;
    font-weight: 600;
    padding: 8px 10px;
    margin: 1px 10px;
    border-radius: 6px;
    text-align: left;
    border: none;
}

#StatusPill {
    background-color: #06030F;
    border: 1px solid #2A1F6B;
    border-radius: 6px;
    padding: 6px 10px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #9A95C8;
}

/* ---------- Toolbar ---------- */
#Toolbar {
    background-color: #0E0A2E;
    border-bottom: 1px solid #2A1F6B;
    min-height: 56px;
    max-height: 56px;
    padding: 0 20px;
}

#ToolbarTitle {
    font-size: 16px;
    font-weight: 700;
    color: #F2F0FF;
}

#ToolbarSub {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: #5B568A;
}

#SearchBox {
    background-color: #06030F;
    border: 1px solid #2A1F6B;
    border-radius: 6px;
    padding: 6px 12px;
}

QLineEdit#SearchInput {
    background: transparent;
    border: none;
    color: #F2F0FF;
    font-size: 12px;
    selection-background-color: #4F3FD6;
}

/* ---------- Drop hint ---------- */
#DropHint {
    background: transparent;
    border: 1px dashed #2A1F6B;
    border-radius: 6px;
    padding: 10px 14px;
    color: #9A95C8;
    font-size: 12px;
}

#DropHintActive {
    border: 1px dashed #4F3FD6;
    background: rgba(79, 63, 214, 0.08);
    color: #F2F0FF;
}

/* ---------- Emulator card ---------- */
#EmulatorCard {
    background-color: #06030F;
    border: 1px solid #2A1F6B;
    border-radius: 10px;
    padding: 16px;
}

#EmulatorCard:hover {
    border: 1px solid #4F3FD6;
    background-color: #0C0820;
}

#EmulatorIconFrame {
    background-color: #15103D;
    border: 1px solid #2A1F6B;
    border-radius: 6px;
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
}

#EmulatorTitle {
    font-size: 15px;
    font-weight: 700;
    color: #F2F0FF;
}

#EmulatorSub {
    font-size: 11px;
    color: #9A95C8;
}

#EmulatorExe {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: #5B568A;
}

/* ---------- Buttons ---------- */
QPushButton#PrimaryButton {
    background-color: #4F3FD6;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #5D4DE0;
}

QPushButton#PrimaryButton:pressed {
    background-color: #3F30B8;
}

QPushButton#PrimaryButton:disabled {
    background-color: #27188E;
    color: #9A95C8;
}

QPushButton#SecondaryButton {
    background-color: #06030F;
    color: #F2F0FF;
    border: 1px solid #2A1F6B;
    border-radius: 6px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#SecondaryButton:hover {
    border-color: #4F3FD6;
    color: #F2F0FF;
}

QPushButton#GhostButton {
    background: transparent;
    color: #9A95C8;
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#GhostButton:hover {
    color: #F2F0FF;
}

/* ---------- Settings ---------- */
#SettingsSidebar {
    background-color: #15103D;
    border-right: 1px solid #2A1F6B;
    min-width: 180px;
    max-width: 180px;
}

#SettingsSection {
    border-bottom: 1px solid #2A1F6B;
    padding: 20px 24px;
}

#SettingsSectionTitle {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #5B568A;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 14px;
}

#SettingsRowLabel {
    font-size: 13px;
    color: #F2F0FF;
    font-weight: 500;
}

#SettingsRowHint {
    font-size: 11px;
    color: #9A95C8;
}

#PathDisplay {
    background-color: #06030F;
    border: 1px solid #2A1F6B;
    border-radius: 6px;
    padding: 6px 10px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #F2F0FF;
}

/* ---------- Installer wizard ---------- */
#InstallerSidebar {
    background-color: #27188E;
    min-width: 200px;
    max-width: 200px;
    padding: 24px;
}

#InstallerBrand {
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
}

#InstallerStep {
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    font-weight: 500;
    padding: 6px 0;
    background: transparent;
    border: none;
    text-align: left;
}

#InstallerStepActive {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 0;
    background: transparent;
    border: none;
    text-align: left;
}

#InstallerStepDone {
    color: rgba(255, 255, 255, 0.8);
    font-size: 12px;
    font-weight: 500;
    padding: 6px 0;
    background: transparent;
    border: none;
    text-align: left;
}

/* ---------- Progress + log ---------- */
QProgressBar#ProgressBar {
    background-color: #15103D;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
}

QProgressBar#ProgressBar::chunk {
    background-color: #4F3FD6;
    border-radius: 3px;
}

QTextEdit#LogView, QPlainTextEdit#LogView {
    background-color: #000000;
    border: 1px solid #2A1F6B;
    border-radius: 6px;
    color: #4ADE80;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
    padding: 14px;
}

/* ---------- Scrollbar ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #2A1F6B;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4F3FD6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0;
}

/* ---------- Misc ---------- */
QToolTip {
    background-color: #06030F;
    color: #F2F0FF;
    border: 1px solid #2A1F6B;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 11px;
}

QMenu {
    background-color: #06030F;
    border: 1px solid #2A1F6B;
    border-radius: 6px;
    padding: 4px;
    color: #F2F0FF;
}

QMenu::item {
    padding: 6px 14px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #4F3FD6;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background: #2A1F6B;
    margin: 4px 0;
}

QCheckBox {
    color: #F2F0FF;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2A1F6B;
    border-radius: 4px;
    background: #06030F;
}

QCheckBox::indicator:checked {
    background: #4F3FD6;
    border-color: #4F3FD6;
    image: url(:/icons/check.png);
}
